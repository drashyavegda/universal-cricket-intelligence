{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//": "TEMPLATE for the phase-5 monorepo (frontend/ as a workspace). The ACTIVE config is /vercel.json at the repository root — do not overwrite it. Kept in sync manually.",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["bom1"],
  "functions": {
    "app/api/**/route.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/app", "destination": "/dashboard", "permanent": false },
    { "source": "/docs", "destination": "/tour", "permanent": true }
  ],
  "github": { "silent": true }
}
