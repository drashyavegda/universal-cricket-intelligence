# =============================================================================
# UCIP — environment template (superset for the hybrid deployment)
# Copy to .env (local) or paste into the Vercel / Render dashboards.
# NOTHING here is required to run the demo. Never commit a real .env file.
# =============================================================================

# --------------------------------------------------------------- application
NODE_ENV=development                     # development | production | test
PORT=3000
HOSTNAME=0.0.0.0

# Canonical origin. MUST be the real https domain in production: it drives
# absolute canonical URLs, og:url and every <loc> in the XML sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ages, workload windows and forecasts are computed relative to this date.
# Keep it fixed so results are reproducible across runs and machines.
REFERENCE_DATE=2027-04-01

# Demo mode labels every synthetic record DEMO. Set false only with real data.
DEMO_MODE=true

# JSON workspace store location (phase 1). Use a mounted volume in containers.
DATA_DIR=.data

# ------------------------------------------------------- database (optional)
# Phase 1 runs on the JSON store. Set both values to use PostgreSQL (Supabase).
# DB_ADAPTER=json                        # json | postgres
# DATABASE_URL=postgresql://user:password@host:5432/ucip
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# Supabase (only if you use Supabase; the pooler URL is preferred for serverless)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=         # public by design, still keep out of git history
# SUPABASE_SERVICE_ROLE_KEY=             # SECRET — server only, never NEXT_PUBLIC_
# SUPABASE_STORAGE_BUCKET=ucip-uploads

# ----------------------------------------------------- object storage (optional)
# Any S3-compatible provider works. Leave blank to store files on local disk.
# STORAGE_DRIVER=local                   # local | s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_MAX_UPLOAD_MB=25

# ------------------------------------------------------------------------ AI
# Optional. Without a key every AI surface returns a labelled deterministic
# fallback. The maths never depends on the model.
# AI_API_KEY=                            # SECRET — server only
# AI_PROVIDER=demo                       # demo | openai-compatible | anthropic | local
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=700
# AI_TEMPERATURE=0.3
# AI_MONTHLY_BUDGET_USD=20               # hard stop once exceeded
# AI_RATE_LIMIT_PER_MINUTE=30
# Local model (Ollama / vLLM) — no paid service:
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b

# ----------------------------------------------------- Python analytics service
# Phase 1 runs with ANALYTICS_SERVICE_URL empty (compute happens in Next.js).
# Phase 2 points this at the Render service.
# ANALYTICS_SERVICE_URL=https://ucip-api.onrender.com
# ANALYTICS_SERVICE_TOKEN=               # SECRET — shared bearer token (phase 4)
# ANALYTICS_TIMEOUT_MS=8000

# ---------------------------------------------- backend (Render) — service side
BACKEND_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated exact origins allowed by CORS. Never use "*" in production.
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_LOG_LEVEL=info                   # debug | info | warning | error
BACKEND_WORKERS=2

# ------------------------------------------------------------------- security
# 32+ character key for AES-256-GCM field encryption (2FA secrets etc.).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FIELD_ENCRYPTION_KEY=
SESSION_MINUTES=720
# Set true only if you front the app with your own proxy; Vercel/Render already
# terminate TLS and redirect http→https at the edge.
ENFORCE_HTTPS=false
# Optional apex/www consolidation target:
# CANONICAL_HOST=analytics.example.com

# --------------------------------------------------------------------- limits
MAX_UPLOAD_MB=25
MAX_ROWS_PER_DATASET=50000
PAGE_SIZE=25

# ------------------------------------------- website quality / SEO / analytics
NEXT_PUBLIC_CONTACT_EMAIL=hello@cricket-intelligence.example
NEXT_PUBLIC_TWITTER_HANDLE=@ucip_analytics
# GA4 — optional; the script only loads after the visitor accepts the banner.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Cloudflare Turnstile CAPTCHA on the public form (both or neither).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Dynamic player share cards: false once the workspace holds real player data.
PUBLIC_PLAYER_PREVIEWS=true

# ------------------------------------------------------------------ telemetry
# No hidden telemetry exists in this build. Listed so you know it is absent.
# UCIP_TELEMETRY=false

# ------------------------------------------- FastAPI service (backend/, Render)
# The Next.js app (frontend/) calls the FastAPI service server-side only; the
# browser never talks to it cross-origin. Set the endpoint in Vercel, not in code.
#   NEXT_PUBLIC_API_URL=https://<your-service>.onrender.com     # origin only, no slash
#   NEXT_PUBLIC_API_URL=http://localhost:8000                   # local development
NEXT_PUBLIC_API_URL=
# Server-only alias (runtime read) for docker compose / private networking.
# ANALYTICS_SERVICE_URL=http://api:8000
# Must equal ANALYTICS_SERVICE_TOKEN on the Render service.
# ANALYTICS_SERVICE_TOKEN=
BACKEND_TIMEOUT_MS=4000

