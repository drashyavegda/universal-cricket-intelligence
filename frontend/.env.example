# ============================================================================
# Universal Cricket Intelligence Platform — environment template
# Copy to .env.local (development) or set these in your deployment platform.
# NEVER commit a real .env file. No key below is required to run the demo.
# ============================================================================

# ---------------------------------------------------------------- application
# Node environment
NODE_ENV=development                    # development | production | test
PORT=3000
HOSTNAME=0.0.0.0

# Workspace reference date: ages, "last 21 days" workload windows and forecasts
# are all computed relative to this date. Keep it fixed for reproducible output.
REFERENCE_DATE=2027-04-01

# Demo mode: when true the platform runs entirely on the synthetic seed and
# labels every synthetic record DEMO. Set false only when you supply real data.
DEMO_MODE=true

# Where the JSON workspace store lives when no database is configured.
DATA_DIR=.data

# ------------------------------------------------------------------ database
# Optional. When DATABASE_URL is set and DB_ADAPTER=postgres, the platform can
# persist to PostgreSQL using db/migrations/0001_init.sql (which includes RLS).
# The demo build runs on the JSON store and needs no database.
# DATABASE_URL=postgresql://ucip:change-me@localhost:5432/ucip
# DB_ADAPTER=json                        # json | postgres
# DATABASE_SSL=false

# ------------------------------------------------------------------------ AI
# Optional. Without AI_API_KEY every AI surface returns deterministic,
# clearly-labelled DEMO narration. The maths never depends on the model.
# AI_API_KEY=
# AI_PROVIDER=demo                       # demo | openai-compatible | anthropic | local
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=700
# AI_TEMPERATURE=0.3
# AI_MONTHLY_BUDGET_USD=20               # hard stop once exceeded
# AI_RATE_LIMIT_PER_MINUTE=30

# Optional local model server (Ollama / vLLM) — no paid service required:
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b

# ------------------------------------------- FastAPI service (backend/ on Render)
# REQUIRED only if you want the Next.js app to talk to the Python service. The
# workspace is fully functional without it: every metric is computed by the
# deterministic TypeScript engines in lib/core.
#
#   local        NEXT_PUBLIC_API_URL=http://localhost:8000
#   deployed     NEXT_PUBLIC_API_URL=https://<your-service>.onrender.com
#
# Rules for this value:
#   * origin only — no trailing slash, no path (https://host, not https://host/ or /docs)
#   * it is inlined into the browser bundle at BUILD time, so redeploy after changing it
#   * never put a secret here — anyone can read NEXT_PUBLIC_* values
NEXT_PUBLIC_API_URL=

# Server-only alias, read at runtime. Useful for container-to-container names
# (docker compose service `api` -> http://api:8000) and for platforms where you
# prefer not to inline the endpoint into the client bundle. Used when
# NEXT_PUBLIC_API_URL is empty.
# ANALYTICS_SERVICE_URL=http://localhost:8000

# Optional shared bearer token for the FastAPI service. Must match the value set
# on the Render service (backend/ reads it as ANALYTICS_SERVICE_TOKEN). Server-only:
# it has no NEXT_PUBLIC_ prefix so it can never reach the browser.
# ANALYTICS_SERVICE_TOKEN=

# Probe timeout for /api/service/status and /api/service/describe (milliseconds).
# A sleeping free Render instance needs a retry, not a longer page render.
BACKEND_TIMEOUT_MS=4000

# ------------------------------------------------------------------- security
# 32+ character key used for AES-256-GCM field encryption (e.g. 2FA secrets).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FIELD_ENCRYPTION_KEY=

# Session lifetime in minutes (also editable in Settings → Security).
SESSION_MINUTES=720

# OAuth is an adapter stub only in this build; leave unset to keep it disabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ------------------------------------------------------------------- limits
MAX_UPLOAD_MB=25
MAX_ROWS_PER_DATASET=50000
PAGE_SIZE=25

# ----------------------------------------------------------------- telemetry
# Optional: send an anonymous heartbeat. Off by default and not implemented in
# this build — listed so you know there is nothing hidden.
# UCIP_TELEMETRY=false

# ============================================================================
# Website quality, SEO, trust & growth  (see docs/SEO_AND_TRUST.md)
# Every value below is OPTIONAL. With none of them set the site still builds,
# serves, redirects, validates forms and produces a sitemap — it just uses
# localhost URLs, shows no analytics and relies on honeypot/rate-limit protection
# instead of a CAPTCHA.
# ============================================================================

# Canonical origin used for absolute canonical links, og:url and the XML sitemap.
# MUST be set in production, e.g. https://analytics.example.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reply-to address shown in the footer, privacy policy and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@cricket-intelligence.example

# Twitter/X handle credited in twitter:site / twitter:creator.
NEXT_PUBLIC_TWITTER_HANDLE=@ucip_analytics

# ------------------------------------------------ analytics (GA4, consent gated)
# Leave blank to disable analytics completely. When set, the GA4 script is only
# loaded after the visitor accepts the consent banner (or has done so before).
# Do Not Track is treated as a decline. No player/email/file data is ever sent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------- CAPTCHA (Cloudflare Turnstile)
# Both values are required to enable the widget. Without them the public form
# keeps honey-pot, timing, rate-limit and duplicate protection — no puzzle shown.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------ transport security
# Managed platforms (Vercel, Render) redirect http→https at the edge already.
# Set to true to have the application itself issue a 308 to https as well.
ENFORCE_HTTPS=false

# Optional apex/www consolidation: visitors on any other host are 308'd here.
# CANONICAL_HOST=analytics.example.com

# Dynamic player share cards. true (default) draws name/role/team/format only.
# Set to false for real, non-consented player data so cards fall back to generic
# branding while link previews still load.
PUBLIC_PLAYER_PREVIEWS=true
